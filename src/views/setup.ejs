<%- include('partials/header', { title: 'Ersteinrichtung' }) %>

<div class="security-step" style="margin: 2rem auto 0; max-width: 560px">
  <div class="security-step-head">
    <span class="icon-chip"><%- include('partials/icon', { name: 'key-round' }) %></span>
    <div>
      <h1>Admin-Zugang anlegen</h1>
      <p>Ein Konto, ein Passwort – das ist die gesamte Nutzerverwaltung dieser App.</p>
    </div>
  </div>
  <div class="security-step-body">
    <% if (error) { %>
      <div class="alert alert-error"><%- include('partials/icon', { name: 'alert-circle' }) %><span><%= error %></span></div>
    <% } %>
    <form method="POST" action="/setup">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Benutzername
        <input type="text" name="username" required autofocus autocomplete="username">
      </label>
      <label>Passwort
        <input type="password" name="password" required minlength="<%= minLength %>" autocomplete="new-password">
      </label>
      <label>Passwort bestätigen
        <input type="password" name="confirmPassword" required minlength="<%= minLength %>" autocomplete="new-password">
      </label>
      <div class="context-hint">
        <%- include('partials/icon', { name: 'lock-keyhole' }) %>
        <span>Mindestens <%= minLength %> Zeichen. Nach 3 Fehlversuchen wird das Konto gesperrt und lässt sich nur per CLI wieder entsperren.</span>
      </div>
      <button type="submit" style="width:100%;justify-content:center"><%- include('partials/icon', { name: 'log-in' }) %>Konto anlegen</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
